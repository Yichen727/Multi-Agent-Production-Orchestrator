# Copy to .env and supply your own credential; no real key belongs in Git.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5
# Existing fallback is unverified; P0 preserves behavior and reports unknown price.
LLM_MODEL_FALLBACK=gpt-5.5-mini
VISION_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
VISION_MAX_ATTEMPTS=3

METADATA_DB_PATH=./app/data/mapo_catalogue.db
RAW_FOOTAGE_DIR=./app/data/raw_footage
PROCESSED_OUTPUT_DIR=./app/data/output
PROXY_OUTPUT_DIR=./app/data/proxies

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
METRICS_ENABLED=true
METRICS_OUTPUT_DIR=./app/data/output/metrics
LOG_LEVEL=INFO
